# Copy to backend/.env for local development. NEVER commit the real file.
# Secrets in this file stay on the server; none of them go into the APK.

ENVIRONMENT=development

# PostgreSQL with the pgvector extension (Supabase provides both).
# Use the Supabase "Session pooler" or direct connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/haven
# For quick local hacking without Postgres:
# DATABASE_URL=sqlite:///./dev.db

# --- Supabase Auth --------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings > API > JWT secret (legacy HS256). Leave empty to verify
# tokens with the project's JWKS (asymmetric signing keys) instead.
SUPABASE_JWT_SECRET=
# Only needed so "Delete my account" can also remove the login.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (paid API, usage-based) ----------------------------------------
AI_PROVIDER=openai           # or "offline" (no key, no voice; for backend dev)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536           # changing this requires a fresh database
USE_MODERATION=true

# --- Limits ------------------------------------------------------------------
REALTIME_SESSIONS_PER_HOUR=20
DEFAULT_CRISIS_REGION=INTL
